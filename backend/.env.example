# Supabase project (local: `supabase status -o env`, hosted: project settings)
SUPABASE_URL=
# Service-role key: backend only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Dev-only: serve sample dashboard data without authentication. Never enable in production.
DASHBOARD_DEMO_MODE=false

# Phase 3+ features (unused in Phase 2)
OPENAI_API_KEY=
YOUTUBE_API_KEY=
