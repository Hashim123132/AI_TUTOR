# Supabase project (local: `supabase status -o env`, hosted: project settings)
SUPABASE_URL=
# Service-role key: backend only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Dev-only: serve sample dashboard data without authentication. Never enable in production.
DASHBOARD_DEMO_MODE=false

# Groq (hosted LLM provider). Backend secret only — NEVER expose to the browser
# and never put this in frontend/.env.local.
GROQ_API_KEY=
# Supported Groq production model id. Override when Groq retires a model
# (see https://console.groq.com/docs/models and /docs/deprecations).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
# Retries handled by the OpenAI SDK; 0 = we surface errors immediately.
GROQ_MAX_RETRIES=0

# Teacher Shneela: HF Space serving the custom Nosheen_Hina PyTorch model.
TEACHER_SHNEELA_SPACE_URL=https://hashimumar-nosheen-hina.hf.space
TEACHER_SHNEELA_TIMEOUT_SECONDS=300

# Phase 3+ features (unused in Phase 2)
OPENAI_API_KEY=
YOUTUBE_API_KEY=
