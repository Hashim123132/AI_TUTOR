# Copy this file to frontend/.env.local and fill in your values.

# Supabase project (Project Settings -> Data API, or `supabase start` output for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Set to "true" to render the dashboard from bundled sample data instead of the API.
NEXT_PUBLIC_DEMO_MODE=false
